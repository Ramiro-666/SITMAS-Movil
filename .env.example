# Copiar a .env.local para desarrollo. No incluir contraseñas ni credenciales SQL.
# En un celular, usar una URL HTTPS accesible con certificado válido.
EXPO_PUBLIC_SITMAS_API_URL=https://localhost:44325/api

# Completar antes de compilar Android; conservar el identificador definitivo.
SITMAS_ANDROID_PACKAGE=com.sitmas.movil
GOOGLE_MAPS_ANDROID_API_KEY=
